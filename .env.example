# ── SERP X-Ray: environment variables ─────────────────────────────
# Copy to .env and fill in. Read automatically by compose (env_file).

# ── API keys (required) ──
OPENROUTER_API_KEY=sk-or-...
SERPAPI_API_KEY=...

# ── Auth (REQUIRED in prod) ──
# Without it the backend won't start (fail-fast). Changing the value + a restart
# instantly invalidates all issued session tokens.
SERPXRAY_ADMIN_PASSWORD=change-me-to-a-long-random-string

# For local development without a password only. Do NOT enable in prod.
# SERPXRAY_AUTH_DISABLED=1

# Session lifetime in days (sliding renewal on every request). Default 30.
# SERPXRAY_SESSION_TTL_DAYS=30

# ── Rate limit / proxy ──
# =1 when the backend sits behind the Next proxy (already set to "1" in docker-compose).
# In dev (localhost:3000 → localhost:8000) leave 0: the IP is taken from the connection.
# SERPXRAY_TRUST_PROXY=0

# ── CORS ──
# Needed only for dev / direct API access. Not involved with Next rewrites (single origin).
# SERPXRAY_CORS_ORIGINS=http://localhost:3000

# ── Domain for HTTPS (Caddy/Let's Encrypt) ──
# Required in docker-compose: {env:SERPXRAY_DOMAIN} in the Caddyfile.
SERPXRAY_DOMAIN=serp.example.com

# ── Internal (change only when necessary) ──
# BACKEND_URL=http://backend:8000   # for the frontend container in compose
# NEXT_PUBLIC_API_URL=              # full API URL if NOT via rewrites (otherwise not needed)
