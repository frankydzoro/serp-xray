# ── SERP X-Ray: переменные окружения ─────────────────────────────
# Скопируйте в .env и заполните. В compose файл читается автоматически (env_file).

# ── Ключи API (обязательны) ──
OPENROUTER_API_KEY=sk-or-...
SERPAPI_API_KEY=...

# ── Авторизация (ОБЯЗАТЕЛЬНО в проде) ──
# Без него backend не стартует (fail-fast). Смена значения + рестарт
# мгновенно инвалидирует все выданные сессионные токены.
SERPXRAY_ADMIN_PASSWORD=change-me-to-a-long-random-string

# Только для локальной разработки без пароля. В проде НЕ включать.
# SERPXRAY_AUTH_DISABLED=1

# Срок жизни сессии в днях (sliding-продление при каждом запросе). По умолчанию 30.
# SERPXRAY_SESSION_TTL_DAYS=30

# ── Rate limit / прокси ──
# =1 когда backend за Next-прокси (в docker-compose уже выставлено "1").
# В dev (localhost:3000 → localhost:8000) оставьте 0: IP берётся из соединения.
# SERPXRAY_TRUST_PROXY=0

# ── CORS ──
# Нужен только для dev/прямого доступа к API. С Next rewrites (один origin) не участвует.
# SERPXRAY_CORS_ORIGINS=http://localhost:3000

# ── Домен для HTTPS (Caddy/Let's Encrypt) ──
# Обязателен в docker-compose: {env:SERPXRAY_DOMAIN} в Caddyfile.
SERPXRAY_DOMAIN=serp.example.com

# ── Внутренние (правьте только при необходимости) ──
# BACKEND_URL=http://backend:8000   # для frontend-контейнера в compose
# NEXT_PUBLIC_API_URL=              # полный URL API, если НЕ через rewrites (иначе не нужно)