# HTTPS-termination: Caddy выпускает и обновляет Let's Encrypt автоматически.
# SERPXRAY_DOMAIN подставляется из .env через {env.*}.
{$SERPXRAY_DOMAIN} {
	# Безопасные заголовки
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	# Всё (включая /api/*) идёт на Next, который сам проксирует /api на backend
	reverse_proxy frontend:3000
}