# HTTPS termination: Caddy issues and renews Let's Encrypt automatically.
# SERPXRAY_DOMAIN is substituted from .env via {env.*}.
{$SERPXRAY_DOMAIN} {
	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	# Everything (including /api/*) goes to Next, which proxies /api to the backend itself
	reverse_proxy frontend:3000
}
